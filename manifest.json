{
  "id": "tmdb-catalog",
  "name": "TMDB Catalog",
  "version": "2.2.0",
  "description": "Catálogo TMDB. Configura API key e idioma en Ajustes → Addons → Configurar.",
  "logo": "https://www.themoviedb.org/assets/2/v4/logos/v2/blue_square_2-d537fb228cf3ded904ef09b136fe3feb79cffa11.svg",
  "author": "Community",
  "types": ["catalog"],
  "type": "catalog",
  "entry": "index.js",
  "resources": ["catalog", "meta", "search"],
  "exports": ["getHome", "discover", "search", "getMeta"],
  "supportedTypes": ["movie", "tv"],
  "contentLanguage": ["es", "en"],
  "configSchema": [
    {
      "key": "api_key",
      "label": "TMDB API Key",
      "type": "password",
      "default": "",
      "required": false
    },
    {
      "key": "language",
      "label": "Idioma",
      "type": "select",
      "default": "es-MX",
      "options": [
        { "value": "es-MX", "label": "Español (México)" },
        { "value": "es-ES", "label": "Español (España)" },
        { "value": "en-US", "label": "English (US)" },
        { "value": "pt-BR", "label": "Português (Brasil)" }
      ]
    }
  ],
  "extra": {
    "provider": "js",
    "language": "es-MX",
    "supports": {
      "home": true,
      "discover": true,
      "search": true,
      "contentPage": true
    }
  }
}
