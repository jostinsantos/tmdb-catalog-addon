  "author": "Community",
  "types": ["catalog"],
  "type": "catalog",
  "entry": "index.js",
  "resources": ["catalog", "meta", "search"],
  "exports": ["getHome", "discover", "search", "getMeta"],
  "supportedTypes": ["movie", "tv", "series"],
  "contentLanguage": ["es", "en"],
