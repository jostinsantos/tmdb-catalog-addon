{
  "id": "tmdb-catalog",
  "name": "TMDB Catalog",
  "version": "2.3.0",
  "description": "Catálogo TMDB con tipos (Películas, Series, Anime, Doramas) y géneros por tipo. API key e idioma en Configurar.",
